# 0x wise — copy to .env and edit, then run:
#   docker compose up -d --build
# The same file works for `npm run dev` / `npm run start`.

# ---- App --------------------------------------------------------------------
# Only used outside Docker. The container always writes to /data.
OXW_DATA_DIR=./data
OXW_EMAIL=me@0xwise.local
OXW_PASSWORD=0xwise
# Keep 1 when serving over plain HTTP on your LAN (cookies would be rejected
# as "Secure" otherwise). Set to 0 when the app sits behind HTTPS.
OXW_INSECURE=1
# Shared secret for the worker and the feed-poll endpoint. Change it.
OXW_CRON_TOKEN=change-me-too
# Host port for the web app.
OXW_PORT=3210

# ---- AI (optional) ----------------------------------------------------------
# ollama | openai | none
OXW_AI_PROVIDER=ollama
# In Docker, Ollama on the host is http://host.docker.internal:11434/v1
# Outside Docker, http://localhost:11434/v1
OXW_AI_BASE_URL=http://host.docker.internal:11434/v1
OXW_AI_MODEL=llama3.1:8b
OXW_AI_API_KEY=

# ---- Worker -----------------------------------------------------------------
OXW_POLL_MINUTES=20
OXW_WORKER_IDLE_SECONDS=5
# tiny | base | small | medium | large-v3, or a folder path such as
# /models/my-model when the model was copied in by hand.
OXW_WHISPER_MODEL=small
# auto | cpu | cuda
OXW_WHISPER_DEVICE=auto
# int8 | int8_float16 | float16 | float32
OXW_WHISPER_COMPUTE=int8
OXW_MAX_MEDIA_MB=2048
# Match your host uid/gid so ./data and ./models stay writable.
OXW_UID=1000
OXW_GID=1000
