{
  "name": "0x-wise",
  "version": "0.1.0",
  "private": true,
  "description": "0x wise — self-hosted reading, listening and highlight review",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "worker": "python3 worker/worker.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^27.0.0",
    "jszip": "^3.10.1",
    "next": "16.4.6",
    "pdfjs-dist": "^5.4.149",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.9"
  }
}
